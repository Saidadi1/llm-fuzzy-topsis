# LLM provider: ollama (default, local) | openai | gemini
LLM_PROVIDER=ollama
# Empty = provider default (ollama: qwen3.5:4b, openai: gpt-4o-mini, gemini: gemini-2.0-flash)
LLM_MODEL=
OLLAMA_HOST=http://localhost:11434

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=...

# Kaggle (for scripts/download_data.py)
# KAGGLE_USERNAME=...
# KAGGLE_KEY=...

LLM_CACHE_PATH=.cache/llm_cache.sqlite
LLM_TIMEOUT=600
SEED=42
